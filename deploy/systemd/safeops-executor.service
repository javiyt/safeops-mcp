[Unit]
Description=SafeOps executor
After=network-online.target

[Service]
Type=simple
User=safeops-executor
Group=safeops
RuntimeDirectory=safeops
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/safeops-executor serve --config /etc/safeops/config.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/safeops /var/lib/safeops
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
